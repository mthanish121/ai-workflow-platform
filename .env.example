# ─────────────────────────────────────────────────────────────
# Backend Environment Configuration (server/.env)
# ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# PostgreSQL Database (Supabase / Local)
DATABASE_URL=postgresql://username:password@localhost:5432/ai_workflow_db

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=7d

# Google Gemini API (Strictly server-side only!)
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe Payment Gateway (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
